#!/usr/bin/zsh
# vim: ft=zsh

{{ template "print.zsh" }}

function waitkey(){
    if [ -f "/tmp/waitkey" ]; then
        echo "WAITING FOR ENTER KEYPRESS"
        read fard
    fi
}

function keepalive_sudo(){
    ssp "One-time sudo prompt"
    sudo -v
    ( while true; do sudo -v; sleep 30; done; ) &
    SUDO_PID="$!"
    trap stop_sudo SIGINT SIGTERM
}

function stop_sudo(){
    ssp "Stopping sudo PID ${SUDO_PID}"
    kill -9 "$SUDO_PID"
    trap - SIGINT SIGTERM
    sudo -k
}

function install_paru(){
    sp "Updating package databases"
    waitkey
    sudo pacman -Sy

    sp "Installing necessary utilities"
    waitkey
    sudo pacman -Sy --noconfirm --needed base-devel git pigz rustup

    sp "Installing latest Rust toolchain"
    waitkey
    rustup toolchain install stable

    # download and setup paru
    sp "Starting paru install"
    waitkey

    git clone https://aur.archlinux.org/paru.git /tmp/paru
    cd /tmp/paru
    makepkg -si --noconfirm
}

# Keep the first occurrence of each package, in dependency order.
typeset -aU install_packages
typeset -A installprofile_state

function resolve_installprofile(){
    local profile="$1"

    if [[ "${installprofile_state[$profile]}" == "visiting" ]]; then
        print -u2 -- "Dependency cycle detected at installprofile: $profile"
        return 1
    fi
    if [[ "${installprofile_state[$profile]}" == "done" ]]; then
        return 0
    fi

    installprofile_state[$profile]="visiting"
    case "$profile" in
{{ range $profile, $packages := .pkgs }}
        {{ $profile | quote }})
{{ range $dependency := index $.deps $profile }}
            resolve_installprofile {{ $dependency | quote }} || return 1
{{ end }}
            install_packages+=(
{{ range $packages }}
                {{ . | quote }}
{{ end }}
            )
            ;;
{{ end }}
        *)
            print -u2 -- "Unknown installprofile or package group: $profile"
            return 1
            ;;
    esac
    installprofile_state[$profile]="done"
}

# Validate and build the package list before making system changes.
resolve_installprofile {{ .installprofile | quote }} || exit 1

# This installation script supports executing first-time setup post-install scripts
# for each package. The script is only called if the package is included in currently-selected
# installprofile. Simply adding the file to setup/<package>.zsh is enough to ensure it is
# executed.
# Setup is selected from the resolved package list, not the profile name.
function has_install_packages(){
    local package
    for package in "$@"; do
        (( ${install_packages[(Ie)$package]} )) || return 1
    done
}

function run_package_setup(){
    local setup="$1"
    shift
    has_install_packages "$@" || return 0
    "$setup"
}

# Each setup/<package>.zsh defines setup_<package> (hyphens become
# underscores). Rendering them here tracks additions, removals and edits for
# run_onchange; each function is invoked below only when its package is listed.
{{ $setupFiles := glob (joinPath .chezmoi.sourceDir ".chezmoitemplates/setup/*.zsh") | sortAlpha }}
{{ range $setupFiles }}
{{ includeTemplate (printf "setup/%s" (base .)) $ }}
{{ end }}

keepalive_sudo

ssp "Applying root filesystem changes"
waitkey
rootmoi apply

if [ ! $(command -v paru) ]; then
    ssp "Installing paru"
    waitkey
    install_paru
fi

if [ ! $(command -v reflector) ]; then
    ssp "Installing reflector"
    waitkey
    paru -Sy --needed --noconfirm reflector
fi

ssp "Installing system packages"
waitkey

if (( ${#install_packages} > 0 )); then
    paru -Sy --needed "${install_packages[@]}"
fi
waitkey

if has_install_packages flatpak; then
    ssp "Installing flatpak packages"
    waitkey
    flatpak install --noninteractive -y flathub {{ .flatpak.workstation | join " " }}
fi

{{ if .cargo.default }}
if has_install_packages rustup; then
    ssp "Installing cargo packages"
    waitkey
    cd /
    cargo install --locked {{ .cargo.default | join " " }}
fi
{{ end }}

# reload systemd so we don't repeat this a million times in the setup scripts
sudo systemctl daemon-reload
systemctl --user daemon-reload

BLOCK_FILE="$HOME/.cache/chezmoi-setup"

# check if this script has already been ran.
if [ -f "${BLOCK_FILE}" ]; then
    stop_sudo
    exit 0
else
    if [ "$EUID" != 0 ]; then
        mkdir -p "${BLOCK_FILE:h}"
        touch "${BLOCK_FILE}"
    fi
fi

ssp "Executing one-time setup"

{{ range $setupFiles }}
{{ $package := trimSuffix ".zsh" (base .) }}
run_package_setup {{ printf "setup_%s" (replace "-" "_" $package) | quote }} {{ $package | quote }}
{{ end }}

waitkey
stop_sudo

ssp "Full install complete. Probably want to reboot."
