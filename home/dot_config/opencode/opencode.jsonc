{
    "$schema": "https://opencode.ai/config.json",
    "plugins": [ ],
    "share": "disabled",
    "update": "notify",
    "permissions": [
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "ls *", "effect": "allow" },
        { "action": "shell", "resource": "rg *", "effect": "allow" },
        { "action": "shell", "resource": "head *", "effect": "allow" },
        { "action": "shell", "resource": "tail *", "effect": "allow" },
        { "action": "shell", "resource": "cat *", "effect": "allow" },
        { "action": "shell", "resource": "test *", "effect": "allow" },
        { "action": "shell", "resource": "find *", "effect": "allow" },
        { "action": "shell", "resource": "sort *", "effect": "allow" },
        { "action": "shell", "resource": "printf *", "effect": "allow" },
        { "action": "shell", "resource": "pwd *", "effect": "allow" },
        { "action": "shell", "resource": "nl *", "effect": "allow" },
        { "action": "shell", "resource": "env *", "effect": "allow" },
        { "action": "shell", "resource": "du *", "effect": "allow" },
        { "action": "shell", "resource": "diff *", "effect": "allow" },
        { "action": "shell", "resource": "grep *", "effect": "allow" },
        { "action": "shell", "resource": "git *", "effect": "deny" },
        { "action": "shell", "resource": "git diff *", "effect": "allow" },
        { "action": "shell", "resource": "git status *", "effect": "allow" },
        { "action": "shell", "resource": "git show *", "effect": "allow" },
        { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
        { "action": "shell", "resource": "git log *", "effect": "allow" },
        { "action": "shell", "resource": "git branch --show-current", "effect": "allow" },
        { "action": "shell", "resource": "git remote -v", "effect": "allow" },
        { "action": "read", "resource": "~/work/**", "effect": "allow" },
        { "action": "edit", "resource": "~/work/**", "effect": "allow" },
        { "action": "glob", "resource": "~/work/**", "effect": "allow" },
        { "action": "grep", "resource": "~/work/**", "effect": "allow" },
        { "action": "external_directory", "resource": "~/work/**", "effect": "allow" },
    ],
    "providers": {
        "moogai": {
            "name": "MoogAI",
            "package": "file://{env:HOME}/.config/opencode/node_modules/@opencode/ai/dist/providers/openai-compatible-responses.js",
            "settings": {
                "baseURL": "{file:/etc/opencode/baseurl}",
                "apiKey": "provided-by-moog-azure-auth-plugin"
            },
            "models": {
                "gpt-6-astra": {
                    "modelID": "gpt-6-astra",
                    "name": "GPT-6 Astra",
                    "family": "gpt-astra",
                    "capabilities": {
                        "tools": true,
                        "input": ["text", "image", "pdf"],
                        "output": ["text"]
                    },
                    "limit": { "context": 1050000, "input": 922000, "output": 128000 },
                    "cost": [
                        {
                            "input": 10,
                            "output": 50,
                            "cache": { "read": 1, "write": 12.5 }
                        },
                        {
                            "tier": { "type": "context", "size": 272000 },
                            "input": 20,
                            "output": 75,
                            "cache": { "read": 2, "write": 25 }
                        }
                    ],
                    "variants": [
                        { "id": "low", "settings": { "reasoningEffort": "low" } },
                        { "id": "medium", "settings": { "reasoningEffort": "medium" } },
                        { "id": "high", "settings": { "reasoningEffort": "high" } },
                        { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
                        { "id": "max", "settings": { "reasoningEffort": "max" } }
                    ]
                },
                "gpt-6.1-sol": {
                    "modelID": "gpt-6.1-sol",
                    "name": "GPT-6.1 Sol",
                    "family": "gpt-sol",
                    "capabilities": {
                        "tools": true,
                        "input": ["text", "image", "pdf"],
                        "output": ["text"]
                    },
                    "limit": { "context": 1050000, "input": 922000, "output": 128000 },
                    "cost": [
                        {
                            "input": 2,
                            "output": 10,
                            "cache": { "read": 0.1, "write": 2.5 }
                        },
                        {
                            "tier": { "type": "context", "size": 272000 },
                            "input": 4,
                            "output": 20,
                            "cache": { "read": 0.4, "write": 5 }
                        }
                    ],
                    "settings": { "reasoningEffort": "medium" },
                    "variants": [
                        { "id": "none", "settings": { "reasoningEffort": "none" } },
                        { "id": "low", "settings": { "reasoningEffort": "low" } },
                        { "id": "medium", "settings": { "reasoningEffort": "medium" } },
                        { "id": "high", "settings": { "reasoningEffort": "high" } },
                        { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
                        { "id": "max", "settings": { "reasoningEffort": "max" } }
                    ]
                },
                "gpt-6-sol": {
                    "modelID": "gpt-6-sol",
                    "name": "GPT-6 Sol",
                    "family": "gpt-sol",
                    "capabilities": {
                        "tools": true,
                        "input": ["text", "image", "pdf"],
                        "output": ["text"]
                    },
                    "limit": { "context": 1050000, "input": 922000, "output": 128000 },
                    "cost": [
                        {
                            "input": 2,
                            "output": 10,
                            "cache": { "read": 0.2, "write": 2.5 }
                        },
                        {
                            "tier": { "type": "context", "size": 272000 },
                            "input": 4,
                            "output": 20,
                            "cache": { "read": 0.4, "write": 5 }
                        }
                    ],
                    "settings": { "reasoningEffort": "medium" },
                    "variants": [
                        { "id": "none", "settings": { "reasoningEffort": "none" } },
                        { "id": "low", "settings": { "reasoningEffort": "low" } },
                        { "id": "medium", "settings": { "reasoningEffort": "medium" } },
                        { "id": "high", "settings": { "reasoningEffort": "high" } },
                        { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
                        { "id": "max", "settings": { "reasoningEffort": "max" } }
                    ]
                },
                "gpt-6-luna": {
